# News proxy (optional)
GNEWS_API_KEY=

# Flash waitlist mail (api/waitlist.ts) — your own mailbox's SMTP login.
# Google Workspace / Gmail: smtp.gmail.com, 465, the address, an App Password.
# Zoho Mail: smtp.zoho.in (or .com), 465, the address, its password / app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where sign-ups go, and who they're from (defaults: mail@quanthive.in, SMTP_USER).
WAITLIST_TO=
WAITLIST_FROM=
# Contact form recipient (optional; default WAITLIST_TO)
CONTACT_TO=

# Careers applications (api/careers.ts). Mailed to CAREERS_TO (default
# WAITLIST_TO) with the CV attached, over the SMTP settings above.
CAREERS_TO=
# Filing in Google Drive + the applicants' sheet: the web app URL of the Apps
# Script in scripts/careers-apps-script.gs, and the secret set in its Script
# Properties (CAREERS_SECRET). Leave empty to skip filing (applications are
# still mailed).
CAREERS_SHEET_URL=
CAREERS_SHEET_SECRET=

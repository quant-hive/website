{
  "name": "flash-3.0",
  "module": "server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot server.ts",
    "start": "bun server.ts",
    "typecheck": "tsc --noEmit",
    "render-video": "bun scripts/render-video.ts",
    "build": "bun build ./index.html --outdir=dist --minify --public-path=/ && cp -r src/assets/icons dist/icons && cp -r src/assets/images dist/images && cp -r src/assets/videos dist/videos && cp -r src/assets/fonts/web dist/fonts &&bun scripts/seo.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "1.60.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@json-render/core": "^0.19.0",
    "@json-render/react": "^0.19.0",
    "@ybouane/liquidglass": "^1.0.3",
    "lenis": "1.3.4",
    "nodemailer": "^10.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  }
}
